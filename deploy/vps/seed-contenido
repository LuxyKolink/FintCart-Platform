#!/usr/bin/env bash
# deploy/vps/seed-contenido — siembra el CATÁLOGO DE DEMOSTRACIÓN en el despliegue del
# colegio: cinco categorías temáticas (SC-009), cada una con un artículo publicado y su
# documento de bloques, y un cuestionario sobre el primero.
#
# Por qué existe
# --------------
# El despliegue se siembra con lo que la plataforma necesita para FUNCIONAR —las siete
# calculadoras y los indicadores del año, `deploy/vps/seed`— y eso deja el catálogo
# editorial VACÍO: la plataforma se ve funcionando, pero el lector no tiene nada que leer
# y la mitad de los recorridos del portafolio no se pueden enseñar. Este guion añade el
# contenido de ejemplo, que es lo que hace que una demostración se vea como el producto y
# no como una instalación a medio hacer.
#
# Es contenido de EJEMPLO, no contenido real: se ve que es una demo y se puede borrar sin
# dejar nada roto. Los textos son los mismos que los del entorno de desarrollo.
#
# Por qué NO crea usuarios
# ------------------------
# `dev/seed` también crea un cliente OAuth y concede roles a cuentas de prueba; eso son
# datos de desarrollo que no pintan nada en producción. Aquí solo va el catálogo, y el
# catálogo es independiente de las cuentas: las identidades del editor y del coordinador
# que exige `article_versions` son UUID opacos que NO existen en Usuarios y no hace falta
# que existan (Aprendizaje guarda referencias opacas y nunca lee la base de otro servicio,
# Principio III). Por eso se puede sembrar en un despliegue donde todavía no hay ninguna
# cuenta creada.
#
# El SQL es el MISMO fichero que usa `dev/seed` (`deploy/contenido-demo.sql`), no una
# copia: dos copias del mismo contenido se separan en cuanto alguien toque una.
#
# Es IDEMPOTENTE: ejecutarlo dos veces no duplica nada.
#
# Uso, en la máquina de DATOS (donde viven los Postgres), después de `deploy/vps/migrate`:
#   deploy/vps/seed-contenido              siembra el catálogo
#   deploy/vps/seed-contenido --comprobar  NO siembra: solo dice qué hay ahora mismo
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
ENV_FILE="$SCRIPT_DIR/.env.data"
COMPOSE_FILE="$SCRIPT_DIR/compose.data.yaml"
SQL_FILE="$ROOT_DIR/deploy/contenido-demo.sql"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31merror\033[0m %s\n' "$*" >&2; exit 1; }

PG_USER="fintcart"
DB="learning_db"

comprobar_solamente=false
case "${1:-}" in
  --comprobar) comprobar_solamente=true ;;
  "") ;;
  *) die "argumento no reconocido: '$1' (usa --comprobar o nada)" ;;
esac

command -v docker >/dev/null 2>&1 || die "Docker no está instalado."
docker info >/dev/null 2>&1 || die "El demonio de Docker no responde."
[[ -f "$ENV_FILE" ]] || die "falta $ENV_FILE — copiar .env.data.example y rellenarlo."
[[ -f "$SQL_FILE" ]] || die "falta $SQL_FILE (el SQL compartido con dev/seed)."
# shellcheck source=/dev/null
source "$ENV_FILE"
[[ -n "${PG_PASSWORD:-}" ]] || die "PG_PASSWORD no está en $ENV_FILE"

# El contenedor se resuelve por Compose y no por nombre fijo: si el proyecto se renombra, el
# guion sigue apuntando al mismo Postgres en vez de a un nombre que ya no existe.
#
# `--env-file` es obligatorio aquí, y no basta con haber hecho `source`: Compose interpola en
# el proceso HIJO, así que las variables de la shell no le llegan salvo que se exporten. Sin
# esto, `ps -q` falla con «required variable PG_PASSWORD is missing» y el guion diría que el
# Postgres no está en marcha cuando sí lo está (la lección costó un rato).
cid="$(docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps -q postgres-learning 2>/dev/null || true)"
[[ -n "$cid" ]] || die "'postgres-learning' no está en marcha. Ejecutar 'docker compose -f compose.data.yaml up -d' antes."

psql_learning() {
  docker exec -i "$cid" psql -v ON_ERROR_STOP=1 -q -U "$PG_USER" -d "$DB" "$@"
}

# Lo que se va a mirar: el contenido y nada más. Los artículos llevan prefijo propio en el
# identificador (`...a01`…`a05`), así que se pueden contar aparte de los que cree cualquiera
# usando la plataforma.
resumen_sql="
select 'categorías   ' || count(*) from categories
union all select 'artículos    ' || count(*) from articles
union all select 'versiones    ' || count(*) from article_versions
union all select 'cuestionarios ' || count(*) from quizzes
union all select 'preguntas    ' || count(*) from questions;"

if [[ "$comprobar_solamente" == true ]]; then
  log "qué hay AHORA MISMO en $DB (no se siembra nada)"
  psql_learning -tAc "$resumen_sql"
  exit 0
fi

log "sembrando el catálogo de demostración (5 categorías, 5 artículos publicados, 1 cuestionario)"
psql_learning < "$SQL_FILE"

log "quedó así"
psql_learning -tAc "$resumen_sql"

cat <<'FIN'

El catálogo se ve en el SPA (aprendizaje → catálogo) en cuanto haya UNA cuenta verificada:
`GET /catalog/articles` exige token —solo `/catalog/categories` y `/calculators` son
públicas—, así que el contenido sembrado no se puede comprobar con un `curl` anónimo. Las
categorías sí:

  curl -s https://<dominio>/api/catalog/categories | head -c 200

FIN
