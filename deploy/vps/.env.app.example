# Plantilla para deploy/vps/.env.app — máquina de APLICACIÓN (la que tiene IP pública
# y DNS asignados por el CTIC: "pg_fintcart", pese al nombre — ver README.md).
#
# Copiar a `.env.app` (no versionar el archivo real) y rellenar con valores reales.

# IP de la máquina de datos, tal como se ve DESDE esta máquina. Usar la IP PRIVADA
# ("pg_fintcart2", 10.154.12.159): las dos VPS del CTIC están en la misma red interna,
# así que Postgres/Redis/RabbitMQ nunca necesitan salir a Internet.
DATA_HOST=10.154.12.159

# Debe coincidir EXACTAMENTE con deploy/vps/.env.data de la otra máquina.
PG_PASSWORD=
RABBITMQ_PASSWORD=

# Firma de los JWT emitidos por Auth y verificados por el Gateway. Generar con:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Dominio público único (Caddy pide un certificado Let's Encrypt al arrancar). El CTIC
# ya lo asignó a la IP pública de esta máquina (207.248.81.119) — un solo dominio, sin
# subdominios, así que el Gateway y el frontend se reparten por RUTA (ver Caddyfile:
# `/api/*` → Gateway, todo lo demás → frontend).
DOMAIN=fintcart.bucaramanga.upb.edu.co

# SMTP con contraseña de aplicación de Gmail (no la contraseña normal de la cuenta):
# Cuenta de Google → Seguridad → Verificación en dos pasos (obligatoria para poder
# generar una) → Contraseñas de aplicaciones. SMTP_FROM debe ser esa misma cuenta de
# Gmail: el servidor rechaza remitentes distintos del autenticado.
SMTP_FROM=tu-cuenta@gmail.com
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=

# Opcional — por defecto 600 (igual que dev/docker-compose.yaml).
# RATE_LIMIT_RPM=600

# Correo que recibe el rol `administrador` en cada arranque de `users` (D-21). Es la
# ÚNICA forma de que exista un administrador: el rol no se concede por la API —un
# endpoint que lo permitiera anularía la separación de responsabilidades de FR-008— y
# no se siembra en una migración, porque quedaría un privilegio escrito en el
# repositorio.
#
# La cuenta tiene que estar ya registrada por el flujo normal de la SPA; si todavía no
# lo está, el servicio arranca igual y registra un aviso, y un arranque posterior
# consuma la promoción. Dejarlo vacío deja la plataforma sin administrador: las
# pantallas de categorías, indicadores y cuentas quedan inaccesibles.
BOOTSTRAP_ADMIN_EMAIL=

# Opcional — cadencia del barrido periódico de indicadores del Orquestador, en el
# formato de `time.ParseDuration` de Go (`1h`, `30m`, `12h`). Por defecto 12h.
#
# Avisa con antelación de los indicadores que están por vencer. No tiene prisa: bajarlo
# mucho en producción solo añade consultas y no adelanta nada. El aviso es además
# una-vez-al-día por indicador, porque el identificador del evento es determinista.
#
# NO hay una variable equivalente para las cuentas: el barrido de purgas que esta
# plantilla anunciaba (`PURGE_SWEEP_INTERVAL`) pertenece al bloque de baja de cuentas,
# que se **descartó** y no existe en el código (ver `specs/002-.../tasks.md`, fase 9).
# La eliminación de una cuenta la cubre la anonimización de 001 (FR-030).

# ── Humo del despliegue (`deploy/vps/e2e`, ver README.md §7) ────────────────────────────
# Cuentas YA VERIFICADAS para la parte autenticada de la suite (catálogo de artículos,
# lectura, simulador y administración). Se crean UNA vez a mano, con dos direcciones del
# mismo buzón (el «+» de Gmail): la del aprendiz se queda como aprendiz, y la del
# administrador va además en BOOTSTRAP_ADMIN_EMAIL para que `users` le conceda el rol al
# arrancar. La suite no puede registrarlas ella misma: el correo de verificación sale por
# SMTP real y el enlace solo lo lee quien tiene el buzón.
#
# Si se dejan vacías no se rompe nada: esas tres pruebas se SALTAN y lo dicen con todas las
# letras («sin E2E_USUARIO_EMAIL: la parte autenticada NO se comprobó»).
E2E_USUARIO_EMAIL=
E2E_USUARIO_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
