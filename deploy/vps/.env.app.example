# Plantilla para deploy/vps/.env.app — máquina de APLICACIÓN (la que tiene IP pública
# y DNS asignados por el CTIC: "pg_fintcart", pese al nombre — ver README.md).
#
# Copiar a `.env.app` (no versionar el archivo real) y rellenar con valores reales.

# IP de la máquina de datos, tal como se ve DESDE esta máquina. Usar la IP PRIVADA
# ("pg_fintcart2", 10.154.12.159): las dos VPS del CTIC están en la misma red interna,
# así que Postgres/Redis/RabbitMQ nunca necesitan salir a Internet.
DATA_HOST=10.154.12.159

# Debe coincidir EXACTAMENTE con deploy/vps/.env.data de la otra máquina.
PG_PASSWORD=
RABBITMQ_PASSWORD=

# Firma de los JWT emitidos por Auth y verificados por el Gateway. Generar con:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Dominio público único (Caddy pide un certificado Let's Encrypt al arrancar). El CTIC
# ya lo asignó a la IP pública de esta máquina (207.248.81.119) — un solo dominio, sin
# subdominios, así que el Gateway y el frontend se reparten por RUTA (ver Caddyfile:
# `/api/*` → Gateway, todo lo demás → frontend).
DOMAIN=fintcart.bucaramanga.upb.edu.co

# SMTP con contraseña de aplicación de Gmail (no la contraseña normal de la cuenta):
# Cuenta de Google → Seguridad → Verificación en dos pasos (obligatoria para poder
# generar una) → Contraseñas de aplicaciones. SMTP_FROM debe ser esa misma cuenta de
# Gmail: el servidor rechaza remitentes distintos del autenticado.
SMTP_FROM=tu-cuenta@gmail.com
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=

# Opcional — por defecto 600 (igual que dev/docker-compose.yaml).
# RATE_LIMIT_RPM=600
