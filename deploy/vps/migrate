#!/usr/bin/env bash
# deploy/vps/migrate — aplica las migraciones de los 7 servicios con estado contra la
# máquina de DATOS del despliegue en las máquinas del colegio.
#
# Adaptación de dev/migrate a esta topología: mismo golang-migrate, mismo criterio de
# "un contenedor por servicio, unido a la red donde vive su Postgres" — solo cambia
# CUÁL red (fintcart-data, no fintcart_fintcart) y de dónde salen usuario/contraseña
# (deploy/vps/.env.data, no un valor fijo de desarrollo).
#
# Ejecutar en la máquina de DATOS, después de `docker compose -f compose.data.yaml up
# -d` y con los 7 Postgres en estado healthy:
#   deploy/vps/migrate            aplica todas las migraciones pendientes (up)
#   deploy/vps/migrate up users   aplica solo las de un servicio
#   deploy/vps/migrate down       revierte TODAS las migraciones (destructivo, pide confirmación)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
ENV_FILE="$SCRIPT_DIR/.env.data"
MIGRATE_IMAGE="migrate/migrate:v4.17.0"
NETWORK="fintcart-data_fintcart-data"

log()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m warn\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merror\033[0m %s\n' "$*" >&2; exit 1; }

command -v docker >/dev/null 2>&1 || die "Docker no está instalado."
docker info >/dev/null 2>&1 || die "El demonio de Docker no responde."
[[ -f "$ENV_FILE" ]] || die "falta $ENV_FILE — copiar .env.data.example y rellenarlo."
# shellcheck source=/dev/null
source "$ENV_FILE"
[[ -n "${PG_PASSWORD:-}" ]] || die "PG_PASSWORD no está en $ENV_FILE"

# La contraseña viaja dentro de una URL (`postgres://fintcart:<esta>@host:puerto/base`),
# así que los caracteres que tienen significado en una URL la rompen: «/» empieza la
# ruta, «?» empieza la query, «#» empieza el fragmento y «@» cambia dónde acaba el
# usuario. El síntoma es un error de resolución de nombres («lookup … server
# misbehaving») que no menciona la contraseña por ningún lado, y se pierde media hora
# buscando en el sitio equivocado.
#
# Se comprueba AQUÍ, en el primer paso que usa la contraseña, y no en los servicios:
# aquí se falla con el motivo delante, y los servicios fallarían después con sus
# propios mensajes de conexión. Si aparece este error y las bases YA están creadas con
# esa contraseña, hay que rehacer los volúmenes (`compose down -v`) o cambiarla dentro
# de las 7 instancias: Postgres guarda la suya en su directorio de datos.
if printf '%s' "$PG_PASSWORD" | grep -q '[/?#@%:&+=]'; then
  die "PG_PASSWORD contiene caracteres que rompen la URL de conexión (/, ?, #, @, %, :, &, + o =).
      Generarla con: openssl rand -hex 32  ·  y usar el MISMO valor en .env.app"
fi

docker network inspect "$NETWORK" >/dev/null 2>&1 \
  || die "la red '$NETWORK' no existe. Ejecutar 'docker compose -f compose.data.yaml up -d' antes."

# Servicio con estado → (contenedor postgres, base de datos, puerto interno fijo en
# 5432 — cada Postgres solo ve el suyo, así que no hay colisión aunque el host los
# publique en puertos distintos).
STATEFUL_SERVICES=(
  "auth-server:postgres-auth:auth_db"
  "users:postgres-users:users_db"
  "learning:postgres-learning:learning_db"
  "simulator:postgres-simulator:simulator_db"
  "notification:postgres-notification:notification_db"
  "audit:postgres-audit:audit_db"
  "orchestrator:postgres-orchestrator:orchestrator_db"
)

DIRECTION="${1:-up}"
shift || true
ONLY=("$@")

case "$DIRECTION" in
  up|down) ;;
  *) die "dirección inválida: '$DIRECTION' (usar 'up' o 'down')" ;;
esac

if [[ "$DIRECTION" == "down" && ${#ONLY[@]} -eq 0 ]]; then
  warn "'migrate down' revierte TODAS las migraciones de las 7 bases y borra sus datos."
  read -r -p "  Escribir 'yes' para continuar: " confirm
  [[ "$confirm" == "yes" ]] || die "cancelado"
fi

failed=()
for entry in "${STATEFUL_SERVICES[@]}"; do
  IFS=':' read -r svc pg_host db <<< "$entry"

  if [[ ${#ONLY[@]} -gt 0 ]] && [[ ! " ${ONLY[*]} " =~ [[:space:]]${svc}[[:space:]] ]]; then
    continue
  fi

  migrations_dir="$ROOT_DIR/services/$svc/migrations"
  if [[ ! -d "$migrations_dir" ]] || [[ -z "$(ls -A "$migrations_dir" 2>/dev/null)" ]]; then
    warn "$svc — sin migraciones todavía, omitido"
    continue
  fi

  log "$DIRECTION → $svc ($db)"
  url="postgres://fintcart:$PG_PASSWORD@$pg_host:5432/$db?sslmode=disable"

  args=("$DIRECTION")
  [[ "$DIRECTION" == "down" ]] && args=("down" "-all")

  if ! MSYS_NO_PATHCONV=1 docker run --rm \
      --network "$NETWORK" \
      --volume "$migrations_dir:/migrations:ro" \
      "$MIGRATE_IMAGE" \
      -path=/migrations -database "$url" "${args[@]}"; then
    failed+=("$svc")
  fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
  die "fallaron las migraciones de: ${failed[*]}"
fi

log "OK — migraciones aplicadas"
