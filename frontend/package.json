    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/angular": "^1.34.0",
    "angular-oauth2-oidc": "^19.0.0",
    "decimal.js": "^10.4.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
