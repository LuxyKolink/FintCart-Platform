#!/usr/bin/env bash
# dev/build — construye las imágenes de desarrollo de los 8 servicios y el frontend.
#
# Uso:
#   dev/build              construye todo
#   dev/build users audit  construye solo los servicios indicados
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_docker

if [[ $# -gt 0 ]]; then
  log "construyendo: $*"
  compose build --pull "$@"
else
  log "construyendo las imágenes de desarrollo de todos los servicios"
  compose build --pull
fi

log "OK — imágenes listas. Siguiente: dev/up"
