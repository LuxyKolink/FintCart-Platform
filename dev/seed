#!/usr/bin/env bash
# dev/seed — carga los datos MÍNIMOS sin los cuales la plataforma no se puede usar.
#
# No es contenido de adorno para una demo. Sin esto:
#
#   · `POST /oauth/authorize` rechaza TODA petición, porque no hay ningún cliente
#     registrado en `oauth_clients` y nadie puede iniciar sesión. Es el único dato
#     que ninguna saga crea y que ningún endpoint permite dar de alta.
#   · `GET /catalog/articles` devuelve una lista vacía y `POST /quizzes/{id}/attempts`
#     no tiene ningún cuestionario al que apuntar, porque el catálogo solo se llena
#     por el flujo editorial, que a su vez exige un usuario con rol.
#   · `GET /calculators` no lista ninguna de las siete calculadoras por defecto de la
#     plataforma (FR-019), así que el simulador arranca sin nada que ejecutar, y `gmf`
#     no puede calcular porque depende del indicador `@UVT`.
#
# Las siete calculadoras y los indicadores los siembra un BINARIO del Simulador y no SQL
# de este script: una definición son tres columnas JSONB producidas por el analizador de
# fórmulas. Ver `services/simulator/src/repo/seeds.rs`.
#
# Por qué NO es una migración: `golang-migrate` versiona el ESQUEMA, y una migración
# que insertara filas las llevaría también a producción, donde este cliente OAuth de
# desarrollo y estos artículos de ejemplo no pintan nada (Principio XI).
#
# Es idempotente: todas las filas llevan identificador fijo y `ON CONFLICT DO NOTHING`,
# de modo que ejecutarlo dos veces no duplica nada.
#
# Uso:
#   dev/seed                          cliente OAuth + catálogo de ejemplo + semillas
#   dev/seed role <correo> <rol>      concede un rol a una cuenta ya registrada
#
# Para probar la superficie REST hace falta un token; lo da `dev/token <correo> [rol...]`,
# que además registra y verifica la cuenta si no existe.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_docker

# Ejecuta SQL por la entrada estándar de psql DENTRO del contenedor de Postgres del
# servicio indicado. El nombre del contenedor y el de la base salen de
# STATEFUL_SERVICES, que es la misma tabla que usa dev/migrate: así el sembrado no
# puede apuntar a una base distinta de la que se migra.
#
# Se usa `docker exec` y no un cliente del host porque psql no es un prerrequisito
# de este repositorio (Principio XII: Docker es lo único que hace falta).
psql_exec() {
  local svc="$1" entry pg_host db cid
  for entry in "${STATEFUL_SERVICES[@]}"; do
    IFS=':' read -r name pg_host db <<< "$entry"
    [[ "$name" == "$svc" ]] && break
    pg_host=""
  done
  [[ -n "$pg_host" ]] || die "servicio con estado desconocido: '$svc'"

  cid="$(compose ps -q "$pg_host" 2>/dev/null || true)"
  [[ -n "$cid" ]] || die "'$pg_host' no está en marcha. Ejecutar 'dev/up' antes de 'dev/seed'."

  docker exec -i "$cid" psql -v ON_ERROR_STOP=1 -q -U "$PG_USER" -d "$db"
}

# ── subcomando: conceder un rol ─────────────────────────────────────────────
#
# Los roles editoriales no se pueden pedir por la API —y con razón: un endpoint que
# permitiera auto-concederse `coordinador_editorial` anularía la separación de
# responsabilidades de FR-008—. Se conceden aquí, contra la base de Usuarios.
seed_role() {
  local email="${1:-}" role="${2:-}"
  [[ -n "$email" && -n "$role" ]] || die "uso: dev/seed role <correo> <rol>"

  # La lista es la de `roles_assignment_role_valid`, y se mantiene a mano porque el
  # script no consulta el esquema: si el CHECK crece y esta línea no, el síntoma es
  # que `dev/seed role` rechaza un rol que la base SÍ admitiría — que es exactamente
  # lo que pasó al añadirse 'administrador' en FR-080 (T022).
  case "$role" in
    usuario_final|editor|coordinador_editorial|administrador) ;;
    *) die "rol inválido: '$role' (usuario_final, editor, coordinador_editorial o administrador)" ;;
  esac

  log "concediendo '$role' a $email"
  # La comprobación de existencia va en SQL y no en bash: si el correo no está
  # registrado, un INSERT ... SELECT no inserta nada y el script terminaría diciendo
  # OK sobre un rol que nadie tiene.
  psql_exec users <<SQL
DO \$\$
DECLARE target UUID;
BEGIN
  SELECT id INTO target FROM profiles
   WHERE email = '${email}' AND account_status = 'active';
  IF target IS NULL THEN
    RAISE EXCEPTION 'no hay ninguna cuenta activa con el correo %', '${email}';
  END IF;
  INSERT INTO roles_assignment (user_id, role) VALUES (target, '${role}')
  ON CONFLICT DO NOTHING;
END
\$\$;
SQL
  log "OK — rol concedido. El token ya emitido NO lo lleva: hay que volver a entrar."
}

if [[ "${1:-}" == "role" ]]; then
  shift
  seed_role "$@"
  exit 0
fi

[[ $# -eq 0 ]] || die "argumento no reconocido: '$1' (ver la cabecera de dev/seed)"

# ── cliente OAuth de la SPA ─────────────────────────────────────────────────
#
# Cliente PÚBLICO: sin secreto y con PKCE obligatorio. Una SPA no puede guardar un
# secreto —el navegador lo entrega a quien mire el bundle—, y por eso la constitución
# fija Authorization Code + PKCE para este caso (Principio VII, research D-05).
log "registrando el cliente OAuth de la SPA (fintcart-spa)"
psql_exec auth-server <<'SQL'
INSERT INTO oauth_clients (id, client_id, client_secret_hash, grant_types, redirect_uris, scopes, is_public)
VALUES (
  '00000000-0000-4000-8000-00000000c1e1',
  'fintcart-spa',
  NULL,
  ARRAY['authorization_code', 'refresh_token'],
  ARRAY['http://localhost:4200/auth/callback'],
  ARRAY['perfil', 'catalogo', 'simulador', 'progreso'],
  TRUE
)
ON CONFLICT (client_id) DO NOTHING;
SQL

# ── catálogo de ejemplo ─────────────────────────────────────────────────────
#
# Cinco categorías temáticas (SC-009), cada una con un artículo publicado, y un
# cuestionario sobre el primero. Los identificadores de autor y aprobador son
# distintos a propósito: `article_versions` exige `approved_by <> created_by`, que es
# el invariante de FR-008 escrito en la base.
log "sembrando el catálogo (5 categorías, 5 artículos publicados, 1 cuestionario)"
# El catálogo de demostración es el MISMO fichero que usa el despliegue
# (`deploy/contenido-demo.sql`): una sola copia del contenido.
psql_exec learning < "$ROOT_DIR/deploy/contenido-demo.sql"

# ── semillas del Simulador ──────────────────────────────────────────────────
#
# Las siete calculadoras de FR-019 y los indicadores del año. A diferencia del resto de
# este script, NO es SQL desde aquí: una definición semilla son tres columnas JSONB
# producidas por el ANALIZADOR de fórmulas, así que hay que ejecutar el binario que las
# compila. Escribirlas a mano en un INSERT sería mantener una segunda copia del AST, y
# una copia que no pasa por el analizador es justo lo que el motor existe para impedir.
# Ver `services/simulator/src/repo/seeds.rs`.
#
# El binario se llama con el entorno del contenedor ya puesto, así que `DB_ADDR` sale del
# compose y el sembrado no puede apuntar a una base distinta de la que se migra.
log "sembrando las 7 definiciones de calculadora y los indicadores del año"
sim_cid="$(compose ps -q simulator 2>/dev/null || true)"
[[ -n "$sim_cid" ]] \
  || die "'simulator' no está en marcha. Ejecutar 'dev/up' antes de 'dev/seed'."

# `docker exec` sobre el id del contenedor, y no `compose exec`, por la misma razón
# que `psql_exec`: MSYS reescribe todo argumento que parezca una ruta POSIX antes de
# que el proceso lo reciba, y convertiría `/src/target/debug/seed` en
# `C:/Program Files/Git/src/target/debug/seed` — el contenedor respondería "no such
# file or directory" sobre un binario que sí existe. Es la trampa que documenta
# `dev/migrate` para `-path=/migrations`.
#
# `MSYS_NO_PATHCONV=1` va AQUÍ y no en `common.sh`: `docker compose -f` SÍ necesita
# la ruta del compose convertida a formato Windows, y desactivarlo en todo el script
# hace que `compose` no encuentre `dev/docker-compose.yaml`.
MSYS_NO_PATHCONV=1 docker exec -i "$sim_cid" /src/target/debug/seed

# El relleno del historial de T020 lo repite el propio binario tras sembrar, y tiene que
# hacerlo: la migración corre ANTES que este script, así que sobre una base virgen no
# encuentra ninguna semilla que citar y deja las filas anteriores en NULL.
log "OK — datos sembrados"
cat <<'EOF'
    Cliente OAuth  fintcart-spa  (público, PKCE S256)
    redirect_uri   http://localhost:4200/auth/callback
    Cuestionario   00000000-0000-4000-8000-000000000c01
    Calculadoras   las 7 semillas, ids 00000000-0000-4000-8000-00000000e001…e007
    Indicadores    5 para el año en curso, con valores de EJEMPLO (no oficiales)

    Para el flujo editorial hace falta un rol:
      dev/seed role <correo> editor
      dev/seed role <correo> coordinador_editorial

    Para la administración (categorías, indicadores, cuentas):
      dev/seed role <correo> administrador
      (o poner el correo en BOOTSTRAP_ADMIN_EMAIL y reiniciar `users`)

    Ojo: 'administrador' NO hereda las atribuciones de 'coordinador_editorial'
    (FR-082) — quien tenga que aprobar contenido necesita el segundo, no el primero.
EOF
