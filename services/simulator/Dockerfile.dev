# syntax=docker/dockerfile:1.7
# Imagen de DESARROLLO del Servicio Simulador (Rust).
#
# Se diferencia de `Dockerfile` en tres cosas, todas deliberadas:
#
#   1. Compila en perfil `dev` (sin `--release`). El perfil de release del
#      `Cargo.toml` activa LTO y `codegen-units = 1`, que multiplican por varios
#      minutos cada recompilación — inaceptable en el ciclo de desarrollo.
#   2. La imagen final CONSERVA el toolchain, para poder entrar con
#      `docker compose exec` y ejecutar `cargo test` o `cargo clippy`.
#   3. Se ejecuta como root, porque en desarrollo se escriben ficheros dentro del
#      contenedor y pelearse con permisos no aporta nada aquí.
#
# NUNCA usar esta imagen fuera de desarrollo.

# Tiene que coincidir con el toolchain de desarrollo: el árbol de dependencias
# resuelto en `Cargo.lock` (la familia `icu_*`, vía `idna_adapter`) declara
# `rust-version = 1.86`, y con 1.85 el build fallaba dentro del contenedor mientras
# compilaba sin problema en la máquina. Un `cargo update --precise` para retroceder
# esas crates arreglaría el síntoma congelando dependencias transitivas por una razón
# que no es nuestra; subir el compilador es la causa.
ARG RUST_VERSION=1.97

FROM rust:${RUST_VERSION}-slim-bookworm

# Los dos componentes que el punto 2 promete y que la imagen NO traía.
#
# Se comprobó al retirar el código nativo (T098): `cargo clippy` y `cargo fmt` no existían dentro
# del contenedor, así que el `--all-targets -- -D warnings` que exige la Constitución §Calidad y
# Pruebas solo podía correrse con el toolchain de la máquina —y el de la máquina no está, o no es
# el mismo—. Una imagen de desarrollo que no puede correr la comprobación que la propia imagen
# documenta es una promesa incumplida, y de las caras: el fallo aparece cuando alguien quiere
# verificar algo, no cuando se construye.
#
# Van ANTES de copiar el código para que su capa no se invalide al tocar un archivo de `src/`: si
# estuvieran después, cada cambio de código volvería a descargar los dos componentes.
RUN rustup component add clippy rustfmt

WORKDIR /src

COPY services/simulator/Cargo.toml services/simulator/Cargo.lock ./
RUN mkdir -p src \
    && echo 'fn main() {}' > src/main.rs \
    && echo '' > src/lib.rs \
    && cargo build \
    && rm -rf src

COPY services/simulator/ ./

RUN touch src/main.rs src/lib.rs && cargo build

EXPOSE 9090

ENTRYPOINT ["/src/target/debug/fintcart-simulator"]
