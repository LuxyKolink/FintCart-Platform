{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "lib": ["ES2023"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // Sin `rootDir`, TypeScript lo infiere del árbol de entradas: al incluir
    // `test/` el ancestro común pasaba a ser la raíz del servicio y la salida
    // caía en `dist/src/main.js`, mientras el Dockerfile y `start:prod`
    // arrancan `dist/main.js`. El contenedor moría en bucle nada más levantarlo.
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // `test/` queda fuera del build a propósito: una imagen de producción no debe
  // llevar pruebas compiladas. Jest las compila por su cuenta con ts-jest, así
  // que excluirlas aquí no las deja sin comprobar de tipos al ejecutarlas.
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
