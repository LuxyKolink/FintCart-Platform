digraph c4_l2 {
  rankdir=LR; bgcolor="white"; nodesep=0.30; ranksep=0.55;
  newrank=true;
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", color="#14477A",
        fillcolor="#F5F2EC", penwidth=1.0, margin="0.14,0.09"];
  edge [color="#5D636A", arrowsize=0.6, penwidth=0.9, fontname="Helvetica", fontsize=8.5, fontcolor="#5D636A"];

  /* columna 1 — borde */
  spa [label=<<B>SPA Angular</B><BR/><FONT POINT-SIZE="8.5">consola del navegador</FONT><BR/><FONT POINT-SIZE="8.5">JWT en sessionStorage</FONT>>, shape=box, fillcolor="#FFFFFF"];
  gw  [label=<<B>API Gateway</B><BR/><FONT POINT-SIZE="8.5">Go · único REST del sistema</FONT><BR/><FONT POINT-SIZE="8.5">sin dominio, sin base de datos</FONT>>, shape=box];

  /* columna 2 — dominio */
  auth  [label=<<B>Auth</B><BR/><FONT POINT-SIZE="8.5">Go · JWT y PKCE</FONT>>, shape=box];
  users [label=<<B>Users</B><BR/><FONT POINT-SIZE="8.5">Go · cuentas y bandeja in-app</FONT>>, shape=box];
  orch  [label=<<B>Orchestrator</B><BR/><FONT POINT-SIZE="8.5">Go · sagas y compensaciones</FONT>>, shape=box];
  learn [label=<<B>Learning</B><BR/><FONT POINT-SIZE="8.5">NestJS · contenido y cuestionarios</FONT>>, shape=box];
  sim   [label=<<B>Simulator</B><BR/><FONT POINT-SIZE="8.5">Rust · motor de fórmulas</FONT>>, shape=box];

  /* columna 4 — consumidores */
  notif [label=<<B>Notification</B><BR/><FONT POINT-SIZE="8.5">Node · solo correo, sin gRPC</FONT>>, shape=box, style="rounded,filled,dashed", fillcolor="#FFFFFF"];
  audit [label=<<B>Audit</B><BR/><FONT POINT-SIZE="8.5">Go · solo registra, sin gRPC</FONT>>, shape=box, style="rounded,filled,dashed", fillcolor="#FFFFFF"];

  /* columna 3 — datos */
  node [shape=cylinder, fillcolor="#E7ECF1", fontsize=9, margin="0.10,0.07"];
  redis [label=<<B>Redis 7.4</B><BR/><FONT POINT-SIZE="8">lista negra JWT · refresh</FONT><BR/><FONT POINT-SIZE="8">límite de tasa del borde</FONT>>, shape=box, style="rounded,filled"];
  rabbit [label=<<B>RabbitMQ 4.0</B><BR/><FONT POINT-SIZE="8">solo eventos de dominio</FONT>>, shape=box, style="rounded,filled"];

  db_auth [label="auth"]; db_users [label="users"]; db_orch [label="orchestrator"];
  db_learn [label="learning"]; db_sim [label="simulator"];
  db_notif [label="notification"]; db_audit [label="audit"];

  smtp [label="Relay SMTP", shape=box, style="rounded,dashed,filled", fillcolor="#FFFFFF"];

  spa -> gw [label="HTTPS / REST"];
  gw -> auth; gw -> users; gw -> learn; gw -> sim; gw -> orch;
  gw -> redis [label="cuenta peticiones", style=dashed, constraint=false];
  auth -> redis [label="tokens", style=dashed];

  auth -> db_auth; users -> db_users; orch -> db_orch; learn -> db_learn; sim -> db_sim;
  notif -> db_notif; audit -> db_audit;

  auth -> rabbit [style=dashed, constraint=false];
  users -> rabbit [style=dashed];
  learn -> rabbit [style=dashed];
  orch -> rabbit [style=dashed];
  rabbit -> notif [label="consume", style=dashed];
  rabbit -> audit [label="consume", style=dashed];
  notif -> smtp [label="correo"];

  { rank=same; notif; audit; }
  notif -> audit [style=invis];
}
